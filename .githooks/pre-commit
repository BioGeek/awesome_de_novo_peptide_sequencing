#!/usr/bin/env bash
# .githooks/pre-commit — keep denovo.sql, the documented counts and slugs.lock
# in lockstep with the repo
#
# When denovo.db is staged, regenerate denovo.sql from it (via `sqlite3 .dump`)
# and add the fresh dump to the same commit. Preserves the invariant CLAUDE.md
# calls out: 'denovo.sql is the canonical human-readable representation; treat
# it as the source of truth when the two disagree.'
#
# Only the dump step depends on denovo.db being staged. The count refresh and
# the URL guard below run on EVERY commit, because both can be invalidated by a
# commit that does not touch the database at all: adding an entity type to
# scripts/slugs.py added 24 published URLs with the .db untouched, and the hook exited
# before the guard ever saw them, which left slugs.lock an incomplete
# inventory -- the exact failure it exists to prevent. Both are stdlib-only and
# instant, so an unrelated commit pays milliseconds.
#
# Enable per-clone with:
#   git config core.hooksPath .githooks

set -e

if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'denovo\.db'; then
  if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "pre-commit: denovo.db is staged but sqlite3 is not installed." >&2
    echo "Install sqlite3 or unstage denovo.db before committing." >&2
    exit 1
  fi
  DB_STAGED=1
else
  DB_STAGED=
fi

# Regenerate the dump from the currently-staged .db. Note: the file on disk
# is what sqlite3 reads, which for a `git add denovo.db` in normal usage is
# identical to the staged blob (denovo.db is not typically staged from a
# different state than the working tree). If you `git add -p denovo.db` or
# stash mid-edit, the assumption breaks — but that would already leave the
# .db in an ambiguous state.
if [ -n "$DB_STAGED" ]; then
  sqlite3 denovo.db .dump > denovo.sql
  git add denovo.sql
fi

# Same idea for the counts quoted in CLAUDE.md and WATCHLIST.md, which argue
# from numbers that go stale the moment a paper is added. scripts/check_counts.py is
# stdlib-only on purpose so the hook needs no uv and no virtualenv.
if [ -f scripts/check_counts.py ] && command -v python3 >/dev/null 2>&1; then
  # The exit status is KEPT, not discarded. --fix rewrites a stale number and
  # returns 0, but it cannot repair a claim whose PATTERN no longer matches the
  # prose, and for that it returns 1. That case was invisible here: the hook
  # said `|| true`, so rewording a sentence in CLAUDE.md -- which is an
  # ordinary thing to do, and which scripts/check_counts.py --fix does itself -- could
  # silently unmatch the pattern that reads a number out of it. The registry
  # entry then checks nothing, and the first anyone hears of it is CI going
  # red. Two commits went out that way.
  counts_rc=0
  python3 scripts/check_counts.py --fix --quiet || counts_rc=$?
  # Claims live in config and source comments too, not just the two docs, so
  # re-stage every file the registry can touch rather than a hardcoded pair.
  # Done BEFORE the failure below, so a refused commit still keeps the numbers
  # --fix just corrected.
  for doc in $(python3 scripts/check_counts.py --list-files); do
    if ! git diff --quiet -- "$doc" 2>/dev/null; then
      git add "$doc"
      echo "pre-commit: refreshed documented counts in $doc."
    fi
  done
  if [ "$counts_rc" -ne 0 ]; then
    echo "pre-commit: refusing this commit, a documented count no longer matches." >&2
    echo "  An UNMATCHED claim means its regex found nothing: the prose was" >&2
    echo "  reworded and that registry entry now checks nothing at all." >&2
    echo "  Fix the wording, or fix the pattern in scripts/check_counts.py, then:" >&2
    echo "    python3 scripts/check_counts.py" >&2
    exit 1
  fi
fi

# URL guard. A slug is derived from mutable data -- a paper's title, an author's
# name -- so editing that data silently rewrites a published URL and 404s the old
# one, which is invisible now and expensive months later.
#
# The two cases are treated differently on purpose. A CHANGED or REMOVED URL is
# never auto-fixed and fails the commit, because rewriting the baseline for
# those IS the failure being guarded against. An ADDED URL is recorded
# automatically, because a new page cannot break an old one and an incomplete
# lock guards nothing.
if [ -f scripts/slugs.py ] && command -v python3 >/dev/null 2>&1; then
  if ! python3 scripts/slugs.py --check --quiet; then
    echo "pre-commit: refusing this commit, it would change a published URL." >&2
    echo "  If the rename is intended:" >&2
    echo "    python3 scripts/slugs.py --write && git add slugs.lock" >&2
    exit 1
  fi
  # The check passed, so the only possible difference is ADDED entries: a
  # CHANGED or REMOVED one exits non-zero above. Adding a brand-new URL to the
  # baseline cannot hide a regression, and leaving it out silently means the
  # lock stops being a complete inventory -- publication 352's page was live
  # and in the sitemap while absent from the lock, so a later rename of it
  # would not have been caught. Refreshing here is safe precisely BECAUSE the
  # dangerous cases already failed.
  python3 scripts/slugs.py --write >/dev/null
  if ! git diff --quiet -- slugs.lock 2>/dev/null; then
    git add slugs.lock
    echo "pre-commit: recorded new page URLs in slugs.lock."
  fi
fi

# Report so the user knows why an extra file joined their commit.
if [ -n "$DB_STAGED" ]; then
  echo "pre-commit: regenerated denovo.sql from staged denovo.db."
fi
