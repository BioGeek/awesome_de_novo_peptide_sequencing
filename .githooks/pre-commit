#!/usr/bin/env bash
# .githooks/pre-commit — keep denovo.sql in lockstep with denovo.db
#
# When denovo.db is staged, regenerate denovo.sql from it (via `sqlite3 .dump`)
# and add the fresh dump to the same commit. Preserves the invariant CLAUDE.md
# calls out: 'denovo.sql is the canonical human-readable representation; treat
# it as the source of truth when the two disagree.'
#
# Skip entirely when denovo.db is NOT staged — no-op cost for unrelated commits.
#
# Enable per-clone with:
#   git config core.hooksPath .githooks

set -e

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qx 'denovo\.db'; then
  # denovo.db not staged — nothing to sync.
  exit 0
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "pre-commit: denovo.db is staged but sqlite3 is not installed." >&2
  echo "Install sqlite3 or unstage denovo.db before committing." >&2
  exit 1
fi

# Regenerate the dump from the currently-staged .db. Note: the file on disk
# is what sqlite3 reads, which for a `git add denovo.db` in normal usage is
# identical to the staged blob (denovo.db is not typically staged from a
# different state than the working tree). If you `git add -p denovo.db` or
# stash mid-edit, the assumption breaks — but that would already leave the
# .db in an ambiguous state.
sqlite3 denovo.db .dump > denovo.sql
git add denovo.sql

# Same idea for the counts quoted in CLAUDE.md and WATCHLIST.md, which argue
# from numbers that go stale the moment a paper is added. check_counts.py is
# stdlib-only on purpose so the hook needs no uv and no virtualenv.
if [ -f check_counts.py ] && command -v python3 >/dev/null 2>&1; then
  python3 check_counts.py --fix --quiet || true
  # Claims live in config and source comments too, not just the two docs, so
  # re-stage every file the registry can touch rather than a hardcoded pair.
  for doc in $(python3 check_counts.py --list-files); do
    if ! git diff --quiet -- "$doc" 2>/dev/null; then
      git add "$doc"
      echo "pre-commit: refreshed documented counts in $doc."
    fi
  done
fi

# URL guard. A slug is derived from mutable data -- a paper's title, an author's
# name -- so editing that data silently rewrites a published URL and 404s the old
# one, which is invisible now and expensive months later. Unlike the counts
# above this is deliberately NOT auto-fixed: rewriting the baseline
# automatically IS the failure being guarded against.
if [ -f slugs.py ] && command -v python3 >/dev/null 2>&1; then
  if ! python3 slugs.py --check --quiet; then
    echo "pre-commit: refusing this commit, it would change a published URL." >&2
    echo "  If the rename is intended:" >&2
    echo "    python3 slugs.py --write && git add slugs.lock" >&2
    exit 1
  fi
fi

# Report so the user knows why an extra file joined their commit.
echo "pre-commit: regenerated denovo.sql from staged denovo.db."
