# Quarto writes <name>_files/ next to any document rendered OUTSIDE the project
# render list (a scratch probe, say). One such directory, 885 KB of bundled
# Bootstrap and JS, was committed by a `git add -A` after exactly that.
/*_files/

# DNPS-DR feed shortlist, same treatment as candidates.csv
dnps_candidates.csv
dnps_summary.md

# Never commit: holds OPENALEX_API_KEY
.env

# SQLite rollback journal, present only while a builder is mid-write
denovo.db-journal
denovo.db-wal
denovo.db-shm
dataset_candidates.csv
